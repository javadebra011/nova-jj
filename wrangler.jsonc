{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-jj",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "75e76aac-ffed-4ae9-8e46-36f8247ee2da","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "79c90b89b98c4741b80775d5b0f03176" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
